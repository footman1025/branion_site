# Resend (contact + job applications)
RESEND_API_KEY=

# Local API server port (default 3001)
API_PORT=3001

# Telegram visitor alerts
# 1. Message @BotFather → /newbot → copy token
# 2. Open your bot and tap Start
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Copy message.chat.id into TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
